# Bootstrap image for the seekr-chain nix mode.
#
# Smallest image that can `nix copy` and then exec. The actual runtime environment
# is feteched from binary cache at runtime.
FROM nixos/nix:2.21.1@sha256:3f6c77ee4d2c82e472e64e6cd7087241dc391421a0b42c22e6849c586d5398d9 AS nix-src

# Enable the modern nix CLI (`nix copy`, `nix run`) and disable build
# sandboxing. Keep Nix's normal multi-user builder isolation: the final stage
# below recreates the upstream nixos/nix:2.21.1 nixbld accounts with their
# fixed numeric IDs, so the root Nix coordinator can still execute each
# derivation as an unprivileged build user.
RUN { \
        echo 'experimental-features = nix-command flakes'; \
        echo 'sandbox = false'; \
        echo 'build-users-group = nixbld'; \
    } >> /etc/nix/nix.conf

# The final image is busybox-based, not nix-src-based — it never has a
# live /nix of its own, so there's nothing for the COPYs below to
# duplicate. (A same-stage `RUN mv /nix /nix-baked` doesn't achieve
# this: Docker layers are additive, so a later RUN can't shrink an
# earlier layer's content — the full /nix from nix-src's own layers
# would still count toward image size even after being `mv`'d away in
# a subsequent layer. Only a genuinely /nix-free base plus an explicit
# cross-stage COPY avoids that.)
FROM busybox:1.36-musl@sha256:3c6ae8008e2c2eedd141725c30b20d9c36b026eb796688f88205845ef17aa213 AS final

# Bake required static busybox symlinks in for the standard POSIX tools
# seekr-chain scripts need. mkfifo backs the named-pipe stderr-tee
# pattern chain-nix-init.sh/nix-build.sh use in place of bash's process
# substitution (`2> >(tee ...)`), which plain /bin/sh can't parse.
RUN for tool in \
        sh head awk cat tee touch sleep time mkfifo \
        ps ls find grep sed kill df du wc tail less more env which \
        chmod chown cp date id mkdir rmdir stat; \
    do \
        ln -sf /bin/busybox /bin/$tool; \
    done

# Preserve the nixos/nix:2.21.1 account ABI even though this final stage is
# BusyBox-based. /nix is shared as a hostPath, so ownership survives image
# changes and these IDs must not be replaced by distro-specific ones. Nix
# chooses its build users from nixbld's member list; primary-group membership
# alone is insufficient for that lookup.
RUN set -eu; \
    nixbld_members=''; \
    i=1; \
    while [ "$i" -le 32 ]; do \
        if [ -n "$nixbld_members" ]; then nixbld_members="$nixbld_members,"; fi; \
        nixbld_members="${nixbld_members}nixbld${i}"; \
        i=$((i + 1)); \
    done; \
    expected_group="nixbld:x:30000:${nixbld_members}"; \
    if grep -qx "$expected_group" /etc/group; then :; \
    elif grep -q '^nixbld:' /etc/group || grep -q '^[^:]*:[^:]*:30000:' /etc/group; then \
        echo 'nixbld name or GID 30000 conflicts with the BusyBox base image' >&2; exit 1; \
    else \
        echo "$expected_group" >> /etc/group; \
    fi; \
    i=1; \
    while [ "$i" -le 32 ]; do \
        uid=$((30000 + i)); \
        expected_user="nixbld${i}:x:${uid}:30000:Nix build user ${i}:/var/empty:/sbin/nologin"; \
        if grep -qx "$expected_user" /etc/passwd; then :; \
        elif grep -q "^nixbld${i}:" /etc/passwd || grep -q "^[^:]*:[^:]*:${uid}:" /etc/passwd; then \
            echo "nixbld${i} name or UID ${uid} conflicts with the BusyBox base image" >&2; exit 1; \
        else \
            echo "$expected_user" >> /etc/passwd; \
        fi; \
        i=$((i + 1)); \
    done

# Preserve nix-src's toolchain at /nix-baked — the only copy of it in
# this image, since `final` is never FROM nix-src. At pod runtime,
# chain-nix-init.sh and nix-build.sh both mount the node's shared
# hostPath (or emptyDir) volume directly at /nix, which shadows
# whatever's here regardless — /nix-baked is what nix-bootstrap.sh
# reseeds that mount from, so a working nix toolchain exists before
# either script runs a real nix command. See
# src/seekr_chain/backends/k8s/resources/nix-bootstrap.sh for the
# reseed logic. /etc/nix/nix.conf and /root/.nix-profile (a symlink
# into /nix) are copied alongside it since both live outside /nix
# proper and are needed for nix/bash to resolve correctly once /nix is
# bootstrapped at runtime.
COPY --from=nix-src /nix /nix-baked
COPY --from=nix-src /etc/nix/nix.conf /etc/nix/nix.conf

# Nix creates store paths through this directory as root, then gives build
# users access via the fixed nixbld GID. Setgid preserves that group for new
# paths and sticky prevents one builder from unlinking another's entries.
# nix-bootstrap.sh repeats this non-recursively for pre-existing hostPath
# stores, whose metadata outlives the image that originally created them.
RUN chown 0:30000 /nix-baked/store && chmod 1775 /nix-baked/store
COPY --from=nix-src /root/.nix-profile /root/.nix-profile

# /bin/bash is required for many autoconf-generated nix builds. The
# symlink target only resolves once /nix is bootstrapped at pod
# runtime — `ln -sf` doesn't dereference, so that's fine at build time.
RUN ln -sf /root/.nix-profile/bin/bash /bin/bash

# add bin to path
ENV PATH=/bin:/root/.nix-profile/bin:/nix/var/nix/profiles/default/bin:/nix/var/nix/profiles/default/sbin
