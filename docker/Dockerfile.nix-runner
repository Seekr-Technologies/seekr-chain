# Bootstrap image for the seekr-chain nix mode.
#
# Smallest image that can `nix copy` and then exec. The actual runtime environment
# is feteched from binary cache at runtime.
#
# Bakes only nix + bash + cacert into a registered store (not a full
# nixpkgs channel) and lands it on a tiny Chainguard base. nix
# substitutes any build's stdenv (git, coreutils, gcc, ...) on demand
# via a shared /nix volume, so baking those in would only bloat the
# image. bash is kept for impure `#!/bin/bash` build scripts.

# Assemble a minimal, registered nix store at /build/root/nix: reuse
# this base's own nix binary (via readlink) plus bash + cacert from
# its pinned <nixpkgs>, so everything shares one glibc/openssl closure.
# `nix copy --to "local?root=..."` (not `nix-store --restore/
# --register-validity`, which silently ignores root=) produces a real
# chroot store with a valid registered DB.
FROM nixos/nix:2.21.1@sha256:3f6c77ee4d2c82e472e64e6cd7087241dc391421a0b42c22e6849c586d5398d9 AS nixbuilder
ENV NIX_CONFIG="experimental-features = nix-command flakes"
RUN set -eu; \
    NIXPKG=$(dirname "$(dirname "$(readlink -f /nix/var/nix/profiles/default/bin/nix)")"); \
    echo "using nix package: $NIXPKG"; \
    PROFILE=$(nix build --no-link --print-out-paths --impure --expr "\
      let pkgs = import <nixpkgs> {}; in pkgs.buildEnv { \
        name = \"seekr-chain-nix-runtime\"; \
        paths = [ (builtins.storePath \"$NIXPKG\") pkgs.bash pkgs.cacert ]; \
        pathsToLink = [ \"/bin\" \"/etc\" ]; \
      }"); \
    echo "built profile: $PROFILE"; \
    nix copy --no-check-sigs --to "local?root=/build/root" "$PROFILE"; \
    mkdir -p /build/root/nix/var/nix/profiles; \
    ln -s "$PROFILE" /build/root/nix/var/nix/profiles/default; \
    echo "minimal store size:"; du -sh /build/root/nix

# wolfi-base's busybox already covers the POSIX tools seekr-chain
# scripts need (chain-nix-init.sh, nix-bootstrap.sh, nix-build.sh,
# nix-gc.sh) — nix's own binaries reference their own glibc under
# /nix/store, so the base just needs a shell.
#
# Chainguard GCs old `:latest` digests, unlike Docker Hub tags — if a
# build fails with "manifest unknown", re-pull and bump this digest.
FROM cgr.dev/chainguard/wolfi-base:latest@sha256:02dab76bd852a70556b5b2002195c8a5fdab77d323c433bf6642aab080489795

# build-users-group = (empty): this base has no `nixbld` group, so nix
# builds as root (already consistent with sandbox = false).
RUN mkdir -p /etc/nix && { \
        echo 'experimental-features = nix-command flakes'; \
        echo 'sandbox = false'; \
        echo 'build-users-group ='; \
    } > /etc/nix/nix.conf

# /nix-baked preserves a working nix toolchain; at pod runtime a
# shared volume mounts directly over /nix, and nix-bootstrap.sh reseeds
# it from /nix-baked (see
# src/seekr_chain/backends/k8s/resources/nix-bootstrap.sh).
#
# `cp -a` + `cp -al` in one layer hardlinks /nix to /nix-baked so they
# share bytes in the layer tar instead of doubling image size. /nix/var
# stays a real copy (not hardlinked) so a local `nix build` can't
# mutate /nix-baked's DB through a shared inode.
RUN --mount=type=bind,from=nixbuilder,source=/build/root/nix,target=/mnt/nix \
    cp -a /mnt/nix /nix-baked && \
    mkdir -p /nix && \
    cp -al /nix-baked/store /nix/store && \
    cp -a  /nix-baked/var   /nix/var

# Required for autoconf-generated nix builds; resolves once /nix is
# bootstrapped at pod runtime (`ln -sf` doesn't dereference at build time).
RUN ln -sf /nix/var/nix/profiles/default/bin/bash /bin/bash

ENV PATH=/bin:/nix/var/nix/profiles/default/bin:/nix/var/nix/profiles/default/sbin
